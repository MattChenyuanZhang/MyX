{
  "manifest_version": 3,
  "name": "MyX \u2014 Your following, your pace",
  "version": "0.7.1",
  "description": "A chronological reader for posts loaded from your X Following feed, with an adjustable share of verified discoveries from your own For You feed. Uses X's native controls.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open MyX"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": [
        "shell.js",
        "boot.js",
        "engine.js",
        "profile.js",
        "sync.js",
        "content.js"
      ],
      "css": ["launcher.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["timeline.js", "observe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "112"
}
